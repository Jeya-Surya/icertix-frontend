# Backend API Endpoint
# Leave empty if frontend & backend are served behind the same CloudFront / Nginx domain
# Or specify your AWS API Gateway / App Runner / ALB URL:
VITE_API_URL=https://api.yourdomain.com

# Public verification URL root
VITE_PUBLIC_VERIFIER_URL=https://app.yourdomain.com/verify/
